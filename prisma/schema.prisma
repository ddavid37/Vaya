// Prisma schema: Part 1 marketplace + Part 2 device-keyed telemetry (no feed↔seed VIN FK).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- enums ---

enum VehicleStatus {
  AVAILABLE
  SUBSCRIBED
  RESERVED
  PENDING_INTAKE
}

/// Live set for the one-commitment invariant: RESERVED | ACTIVE | ENDING.
/// CONFLICTING = quarantined seed/runtime row (not live; excluded from unique index).
enum SubscriptionStatus {
  RESERVED
  ACTIVE
  ENDING
  ENDED
  CONFLICTING
}

enum LedgerEntryType {
  PERIOD_BASE
  MILES_INCLUDED
  MILES_USED
  OVERAGE
  PRORATION
}

enum ConflictType {
  DUAL_LIVE_SUBSCRIPTION
  VEHICLE_STATUS_MISMATCH
  PRICE_MISMATCH
  ODOMETER_IMPOSSIBILITY
}

enum TripAssemblyStatus {
  OPEN
  COMPLETE
  METRICS_DELAYED
  IMPOSSIBLE_ODOMETER
  INCOMPLETE
}

/// Which input MileageDecision trusted for billable miles.
enum MileageSource {
  ODOMETER_DELTA
  TRIP_DISTANCE
  NONE
}

// --- catalog / fleet ---

model Dealer {
  id       String    @id
  name     String
  city     String
  state    String
  joinedAt DateTime  @map("joined_at") @db.Date
  vehicles Vehicle[]

  @@map("dealers")
}

model Plan {
  id             String         @id
  name           String
  tier           String
  monthlyMiles   Int            @map("monthly_miles")
  overagePerMile Decimal        @map("overage_per_mile") @db.Decimal(10, 2)
  basePrice      Decimal        @map("base_price") @db.Decimal(10, 2)
  subscriptions  Subscription[]

  @@map("plans")
}

model Vehicle {
  id            String         @id
  vin           String         @unique
  dealerId      String         @map("dealer_id")
  dealer        Dealer         @relation(fields: [dealerId], references: [id])
  year          Int
  make          String
  model         String
  trim          String
  color         String
  odometer      Int
  /// Display projection — not the availability lock. See live subscription index.
  status        VehicleStatus
  monthlyPrice  Decimal?       @map("monthly_price") @db.Decimal(10, 2)
  listedAt      DateTime       @map("listed_at") @db.Date
  subscriptions Subscription[]

  @@map("vehicles")
}

model Driver {
  id            String         @id
  email         String
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  phone         String?
  licenseState  String         @map("license_state")
  createdAt     DateTime       @map("created_at") @db.Date
  subscriptions Subscription[]

  @@map("drivers")
}

// --- commitment ---

model Subscription {
  id                   String             @id
  driverId             String             @map("driver_id")
  driver               Driver             @relation(fields: [driverId], references: [id])
  vehicleId            String             @map("vehicle_id")
  vehicle              Vehicle            @relation(fields: [vehicleId], references: [id])
  planId               String             @map("plan_id")
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus
  /// Billing snapshot — what we owe under, not plans.base_price.
  monthlyPrice         Decimal            @map("monthly_price") @db.Decimal(10, 2)
  startDate            DateTime           @map("start_date") @db.Date
  endDate              DateTime?          @map("end_date") @db.Date
  billingPeriodStart   DateTime?          @map("billing_period_start") @db.Date
  billingPeriodEnd     DateTime?          @map("billing_period_end") @db.Date
  startOdometer        Int                @map("start_odometer")
  milesThisPeriod      Int                @default(0) @map("miles_this_period")
  cancelledAt          DateTime?          @map("cancelled_at")
  previousPlanId       String?            @map("previous_plan_id")
  previousMonthlyPrice Decimal?           @map("previous_monthly_price") @db.Decimal(10, 2)
  ledgerEntries        LedgerEntry[]

  @@index([vehicleId, status])
  @@index([driverId])
  @@map("subscriptions")
}

/// Append-only audit for billing-relevant mutations.
/// subjectType + subjectId is polymorphic (subscription | vehicle).
model DomainEvent {
  id          String   @id
  at          DateTime
  type        String
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  data        Json

  @@index([subjectType, subjectId])
  @@index([at])
  @@map("domain_events")
}

/// Explainable money-shaped facts for ops / email defense. No card charges.
model LedgerEntry {
  id             String          @id @default(cuid())
  subscriptionId String          @map("subscription_id")
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id])
  type           LedgerEntryType
  amount         Decimal         @db.Decimal(10, 2)
  quantity       Decimal?        @db.Decimal(12, 3)
  unit           String?
  explanation    String
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([subscriptionId])
  @@map("ledger_entries")
}

/// Quarantine / mismatch records. Never silently rewrite bad seed rows away.
model DataConflict {
  id          String       @id @default(cuid())
  type        ConflictType
  subjectType String       @map("subject_type")
  subjectIds  String[]     @map("subject_ids")
  resolution  String
  rationale   String
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("data_conflicts")
}

// --- Part 2 telemetry (device-keyed; no FK into marketplace vehicles) ---

/// Telematics unit. Identity = IMEI. A device can move between cars.
model Device {
  imei        String                    @id
  firstSeenAt DateTime                  @map("first_seen_at")
  lastSeenAt  DateTime                  @map("last_seen_at")
  assignments DeviceVehicleAssignment[]
  rawEvents   TelemetryRaw[]
  trips       Trip[]

  @@map("devices")
}

/// Time-bounded IMEI ↔ VIN binding. Closed on vinChange or explicit end.
model DeviceVehicleAssignment {
  id        String    @id @default(cuid())
  imei      String
  device    Device    @relation(fields: [imei], references: [imei])
  vin       String
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  /// Raw event natural key that opened this interval (e.g. vinChange / first trip).
  openedBy  String?   @map("opened_by")
  closedBy  String?   @map("closed_by")

  @@index([imei, startedAt])
  @@index([vin, startedAt])
  @@map("device_vehicle_assignments")
}

/// Exact vendor payload, append-only. Idempotent on naturalKey.
model TelemetryRaw {
  id            String    @id @default(cuid())
  /// Deterministic idempotency key (source|event|deliveredAt|imei|transactionId|…).
  naturalKey    String    @unique @map("natural_key")
  deliveredAt   DateTime  @map("delivered_at")
  source        String
  event         String
  imei          String?
  device        Device?   @relation(fields: [imei], references: [imei])
  transactionId String?   @map("transaction_id")
  eventAt       DateTime? @map("event_at")
  payload       Json
  ingestedAt    DateTime  @default(now()) @map("ingested_at")

  @@index([imei, deliveredAt])
  @@index([transactionId])
  @@index([event, deliveredAt])
  @@map("telemetry_raw")
}

/// Assembled billing/ops unit from tripStart/End/Metrics (and REST trip).
model Trip {
  id              String             @id @default(cuid())
  transactionId   String             @unique @map("transaction_id")
  imei            String
  device          Device             @relation(fields: [imei], references: [imei])
  /// VIN at assembly time (from fragments or active assignment). Not a marketplace FK.
  vin             String?
  startAt         DateTime?          @map("start_at")
  endAt           DateTime?          @map("end_at")
  startOdometer   Decimal?           @map("start_odometer") @db.Decimal(12, 3)
  endOdometer     Decimal?           @map("end_odometer") @db.Decimal(12, 3)
  tripDistance    Decimal?           @map("trip_distance") @db.Decimal(12, 3)
  assemblyStatus  TripAssemblyStatus @map("assembly_status")
  /// e.g. webhook fragments, rest snapshot, delayed metrics.
  flags           String[]           @default([])
  notes           String?
  updatedAt       DateTime           @updatedAt @map("updated_at")
  mileageDecision MileageDecision?

  @@index([imei, startAt])
  @@index([vin, startAt])
  @@map("trips")
}

/// Billable miles for a trip — which inputs we trusted, which we discarded, why.
model MileageDecision {
  id              String        @id @default(cuid())
  tripId          String        @unique @map("trip_id")
  trip            Trip          @relation(fields: [tripId], references: [id])
  trustedMiles    Decimal?      @map("trusted_miles") @db.Decimal(12, 3)
  source          MileageSource
  /// Structured discard notes (odometer delta, tripDistance, etc.).
  discardedInputs Json          @map("discarded_inputs")
  rationale       String
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("mileage_decisions")
}
