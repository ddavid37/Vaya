{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/auth": ["./be/auth.ts"],
      "@/lib/*": ["./be/lib/*"],
      "@/components/*": ["./fe/components/*"],
      "@/*": ["./fe/*", "./be/*"]
    }
  },
  "include": [
    "fe/**/*.ts",
    "fe/**/*.tsx",
    "be/**/*.ts",
    "be/**/*.tsx",
    "fe/next-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
