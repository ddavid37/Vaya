{
  "name": "vaya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack fe",
    "build": "prisma generate && next build --turbopack fe",
    "postinstall": "prisma generate",
    "start": "next start fe",
    "lint": "eslint fe be",
    "db:seed": "tsx be/scripts/seed.ts",
    "db:ingest": "tsx be/scripts/ingest.ts",
    "db:assemble": "tsx be/scripts/assemble.ts",
    "test": "tsx --test be/tests/**/*.test.ts",
    "test:telemetry": "tsx --test be/tests/telemetry.test.ts",
    "check:secrets": "bash be/scripts/check-secrets.sh"
  },
  "prisma": {
    "schema": "be/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5"
  }
}
